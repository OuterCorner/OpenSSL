OPENSSL_VERSION = 4.0.3
BUILD_VERSION = 261021.0

CURRENT_PROJECT_VERSION = $(BUILD_VERSION)

ENABLE_BITCODE = NO

OPENSSL_OPTIONS = no-weak-ssl-ciphers no-async no-tests

APPLICATION_EXTENSION_API_ONLY = YES
